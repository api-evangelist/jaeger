          "request": {
            "name": "Get service dependency graph",
            "description": {
              "content": "Retrieve the dependency graph showing relationships between services based on observed traces. Returns edges representing calls from one service to another with call counts.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "dependencies"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "endTs",
                  "value": "<long>",
                  "description": "(Required) End timestamp in Unix milliseconds."
                },
                {
                  "disabled": false,
                  "key": "lookback",
                  "value": "<long>",
                  "description": "(Required) Duration to look back from endTs in milliseconds."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
